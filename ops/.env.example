# Copy this file to .env (local dev) or set these in the Vercel project's Environment Variables
# (production). Every variable the app reads from process.env is listed here — see lib/db.ts,
# lib/session.ts, and app/api/website-intake/route.ts for where each one is actually used.

# --- Database (required) ------------------------------------------------------------------------
# Postgres in every environment — see prisma/schema.prisma's datasource.
#
# Local dev: run `npm run pg:local:start` in its own terminal (a real Postgres binary, no Docker/
# cloud account needed — see prisma/local-postgres.ts), then use the URL it prints:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/tripgate"
#
# Production (Neon): use the POOLED connection string (the one with "-pooler" in the hostname) as
# DATABASE_URL for the deployed app itself — Vercel serverless functions churn through connections
# fast enough that pgbouncer pooling matters. For one-off admin work (`prisma migrate deploy`,
# `db:seed`, `db:seed:admin`), use the UNPOOLED string instead — pgbouncer's transaction-pooling
# mode can interfere with the schema engine's advisory locks / prepared statements during DDL.
# DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL=

# --- Website intake bridge (required) -----------------------------------------------------------
# Shared secret the marketing site's FormStateContext.tsx sends via the x-tripgate-intake-secret
# header when notifying this app of a new enquiry (see app/api/website-intake/route.ts). Generate a
# fresh value per environment — never reuse the same value across dev/production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WEBSITE_INTAKE_SECRET=

# Restricts the website-intake endpoint's CORS to the marketing site's real origin instead of the
# dev-only "*" fallback. Leave unset locally; set for production:
# WEBSITE_ORIGIN="https://tripgatemorocco.com"
WEBSITE_ORIGIN=

# --- Bootstrap admin (only needed to run `npm run db:seed:admin`, not read by the app itself) ----
# That script creates/updates the one Administrator account a fresh database starts with (see
# prisma/seed-admin.ts) — there is no self-registration flow. Set a real password before running it
# against any shared database; rotate it from Settings once you've signed in.
BOOTSTRAP_ADMIN_EMAIL=admin@tripgatemorocco.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
